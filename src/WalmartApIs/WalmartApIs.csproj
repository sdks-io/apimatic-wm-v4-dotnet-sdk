<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="NoWarn">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Apimaticwmv4SDK</PackageId>
        <AssemblyName>Apimaticwmv4SDK</AssemblyName>
        <Authors>developer sdksio</Authors>
        <Description>This is a sample SDK generated by APIMatic</Description>
        <PackageTags>apimatic;sdksio</PackageTags>
        <PackageProjectUrl>https://apimatic.io</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sdks-io/apimatic-wm-v4-dotnet-sdk.git</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1570;CS1573;CS1591</NoWarn>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
        <PackageReference Include="Microsoft.Bcl.TimeProvider" />
        <PackageReference Include="Polly" />
        <PackageReference Include="PolySharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Net.Http.Json" />
        <PackageReference Include="System.Net.ServerSentEvents" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

</Project>